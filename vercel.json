{
  "version": 2,
  "framework": null,
  "buildCommand": "mkdir -p dist && echo 'API' > dist/index.html",
  "outputDirectory": "dist",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
